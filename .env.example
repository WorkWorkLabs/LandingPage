# App Configuration
VITE_APP_TITLE="WorkWork - Global Remote Work Ecosystem"
VITE_APP_URL="https://workwork.works"
VITE_API_URL="https://api.workwork.works"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Map Configuration
# 默认 Leaflet + CARTO 手绘底图（国内/国外统一，零 Key 可用）
VITE_MAP_PROVIDER="leaflet"
VITE_MAP_DEFAULT_ZOOM="13"
VITE_MAP_USER_ZOOM="15"

# 搜索（可选，不配 Key 时默认 OSM 零 Key 搜索）
# 高德 Web 服务 Key — 可选，增强国内 POI 命中率（需一次性免费注册）
VITE_AMAP_KEY=""
# 百度地图 AK — 可选
VITE_BAIDU_MAP_KEY=""
# Google Maps Key — 可选，海外搜索优先
VITE_GOOGLE_MAPS_KEY=""

# Analytics (optional)
VITE_GA_ID=""

# Social Media
VITE_TWITTER_HANDLE="WorkWorkOrg"
VITE_GITHUB_URL="https://github.com/workwork"