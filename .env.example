# App Configuration
VITE_APP_TITLE="WorkWork - Global Remote Work Ecosystem"
VITE_APP_URL="https://workwork.works"
VITE_API_URL="https://api.workwork.works"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Map Configuration
# 默认仍使用 Leaflet + CARTO 免费底图；其它 provider key 供地点解析/后续 SDK 集成使用
VITE_MAP_PROVIDER="leaflet"
VITE_MAP_DEFAULT_ZOOM="13"
VITE_MAP_USER_ZOOM="15"
# 高德地图 Web 端 JS API Key（在中国大陆使用）
VITE_AMAP_KEY="your-amap-key-here"
# 百度地图 AK（中国大陆地点检索/链接解析）
VITE_BAIDU_MAP_KEY="your-baidu-map-key-here"
# Google Maps JavaScript API Key（在海外使用）
VITE_GOOGLE_MAPS_KEY="your-google-maps-key-here"

# Analytics (optional)
VITE_GA_ID=""

# Social Media
VITE_TWITTER_HANDLE="WorkWorkOrg"
VITE_GITHUB_URL="https://github.com/workwork"
